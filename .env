# GenAI Developer Productivity Agent — Environment Variables

APP_NAME=GenAI Developer Productivity Agent
APP_VERSION=1.0.0
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# LLM Provider: "local" (no API key needed) or "openai"
LLM_PROVIDER=local

# OpenAI (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.3
OPENAI_TIMEOUT=60

# Monitoring
LOG_LEVEL=INFO
METRICS_ENABLED=true

# Resilience
RETRY_MAX_ATTEMPTS=3
RETRY_WAIT_SECONDS=1
DEFAULT_TIMEOUT_SECONDS=120
